javascript:(()=>{if(window.__ACV_SNIP_AI__){window.__ACV_SNIP_AI__.off();return}const S={busy:false,overlay:null,panel:null,data:null,keydown:null};function rm(x){try{x&&x.remove()}catch(e){}}function closeAll(){rm(S.overlay);rm(S.panel);S.overlay=S.panel=null;S.busy=false}function toast(t){let d=document.createElement('div');d.textContent=t;d.style.cssText='position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:2147483647;background:#111;color:#7fffd4;border:2px solid #20e0d0;padding:9px 14px;font:700 14px Arial;border-radius:7px;box-shadow:0 0 16px #20e0d088';document.body.appendChild(d);setTimeout(()=>d.remove(),1800)}async function copySnip(){if(!S.data)return;try{let b=await(await fetch(S.data)).blob();await navigator.clipboard.write([new ClipboardItem({'image/png':b})]);toast('Snip copied')}catch(e){toast('Clipboard blocked')}}function panel(data){rm(S.panel);S.data=data;let p=document.createElement('div');S.panel=p;p.style.cssText='position:fixed;right:20px;top:70px;width:min(430px,calc(100vw - 40px));max-height:82vh;overflow:auto;z-index:2147483647;background:#101315;color:#eee;border:2px solid #2ee6d6;border-radius:9px;padding:12px;box-shadow:0 0 24px #00e5d455;font-family:Arial,sans-serif';p.innerHTML='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><b style="font-size:17px;color:#63fff0">ACV AI SNIP</b><button data-x style="background:#222;color:#fff;border:1px solid #777;border-radius:4px;font-size:18px;cursor:pointer">×</button></div><img data-img style="display:block;width:100%;max-height:330px;object-fit:contain;background:#000;border:1px solid #555;border-radius:4px"><textarea data-q placeholder="Ask something about this clipped image..." style="box-sizing:border-box;width:100%;min-height:82px;margin-top:9px;background:#090b0c;color:#fff;border:1px solid #5d7775;border-radius:5px;padding:9px;font:14px Arial;resize:vertical"></textarea><div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:8px"><button data-ask style="background:#17b7a7;color:#fff;border:0;border-radius:5px;padding:8px 12px;font-weight:700;cursor:pointer">Analyze</button><button data-copy style="background:#333;color:#fff;border:1px solid #666;border-radius:5px;padding:8px 12px;cursor:pointer">Copy Snip</button><button data-retake style="background:#333;color:#fff;border:1px solid #666;border-radius:5px;padding:8px 12px;cursor:pointer">Retake</button></div><div data-out style="margin-top:10px;white-space:pre-wrap;line-height:1.35;color:#ddd"></div>';p.querySelector('[data-img]').src=data;p.querySelector('[data-x]').onclick=()=>{rm(p);S.panel=null};p.querySelector('[data-copy]').onclick=copySnip;p.querySelector('[data-retake]').onclick=()=>{rm(p);S.panel=null;start()};p.querySelector('[data-ask]').onclick=()=>{let q=p.querySelector('[data-q]').value.trim(),o=p.querySelector('[data-out]');if(!q){o.textContent='Type a question first.';return}o.innerHTML='<b style="color:#ffd65a">Crop tool is working.</b> AI is not connected yet. The next step is wiring this button to a secure AI endpoint.'};document.body.appendChild(p);p.querySelector('[data-q]').focus()}function select(shot){rm(S.overlay);let ov=document.createElement('div');S.overlay=ov;ov.style.cssText='position:fixed;inset:0;z-index:2147483647;background:#000;cursor:crosshair;user-select:none';let c=document.createElement('canvas');c.width=shot.width;c.height=shot.height;c.style.cssText='position:absolute;inset:0;width:100%;height:100%';c.getContext('2d').drawImage(shot,0,0);ov.appendChild(c);let sel=document.createElement('div');sel.style.cssText='position:absolute;border:2px solid #00fff0;background:#00fff022;box-shadow:0 0 0 9999px #0007;display:none;pointer-events:none';ov.appendChild(sel);let tip=document.createElement('div');tip.textContent='Drag to clip • Esc cancels';tip.style.cssText='position:absolute;top:12px;left:50%;transform:translateX(-50%);background:#111d;color:#fff;border:1px solid #00fff0;border-radius:5px;padding:7px 10px;font:700 13px Arial;pointer-events:none';ov.appendChild(tip);let sx=0,sy=0,drag=false;ov.onpointerdown=e=>{sx=e.clientX;sy=e.clientY;drag=true;sel.style.display='block';e.preventDefault()};ov.onpointermove=e=>{if(!drag)return;let x=Math.min(sx,e.clientX),y=Math.min(sy,e.clientY),w=Math.abs(e.clientX-sx),h=Math.abs(e.clientY-sy);sel.style.left=x+'px';sel.style.top=y+'px';sel.style.width=w+'px';sel.style.height=h+'px'};ov.onpointerup=e=>{if(!drag)return;drag=false;let x=Math.min(sx,e.clientX),y=Math.min(sy,e.clientY),w=Math.abs(e.clientX-sx),h=Math.abs(e.clientY-sy);if(w<20||h<20){toast('Selection too small');return}let r=c.getBoundingClientRect(),kx=shot.width/r.width,ky=shot.height/r.height,cc=document.createElement('canvas');cc.width=Math.round(w*kx);cc.height=Math.round(h*ky);cc.getContext('2d').drawImage(shot,Math.round((x-r.left)*kx),Math.round((y-r.top)*ky),cc.width,cc.height,0,0,cc.width,cc.height);rm(ov);S.overlay=null;S.busy=false;panel(cc.toDataURL('image/png'))};document.body.appendChild(ov)}async function start(){if(S.busy)return;S.busy=true;rm(S.panel);S.panel=null;try{let st=await navigator.mediaDevices.getDisplayMedia({video:true,audio:false}),v=document.createElement('video');v.srcObject=st;v.muted=true;v.playsInline=true;await v.play();await new Promise(r=>setTimeout(r,120));let c=document.createElement('canvas');c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0);st.getTracks().forEach(t=>t.stop());S.busy=false;select(c)}catch(e){S.busy=false;toast('Capture canceled or blocked')}}S.keydown=e=>{if(e.key==='F5'){e.preventDefault();e.stopImmediatePropagation();start()}else if(e.key==='Escape')closeAll()};window.addEventListener('keydown',S.keydown,true);S.off=()=>{window.removeEventListener('keydown',S.keydown,true);closeAll();delete window.__ACV_SNIP_AI__;toast('ACV AI Snip disabled')};window.__ACV_SNIP_AI__=S;toast('ACV AI Snip ON • F5 to capture')})()
