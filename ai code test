javascript:(()=>{if(window.__acvPasteAI){window.__acvPasteAI.off();return}const S={p:null,k:null,paste:null,data:null};const rm=e=>{try{e&&e.remove()}catch(_){}};function note(t){let d=document.createElement("div");d.textContent=t;d.style.cssText="position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:2147483647;background:#111;color:#7fffd4;border:2px solid #20e0d0;padding:8px 12px;border-radius:6px;font:700 14px Arial;box-shadow:0 0 14px #00e5d477";document.body.appendChild(d);setTimeout(()=>d.remove(),1800)}function openPanel(){rm(S.p);let p=S.p=document.createElement("div");p.style.cssText="position:fixed;right:18px;top:60px;width:420px;max-width:calc(100vw - 36px);max-height:82vh;overflow:auto;z-index:2147483647;background:#101315;color:#eee;border:2px solid #2ee6d6;border-radius:8px;padding:10px;box-shadow:0 0 22px #00e5d455;font-family:Arial";p.innerHTML='<div style="display:flex;justify-content:space-between;align-items:center"><b style="color:#63fff0;font-size:17px">ACV AI SNIP</b><button data-x style="background:#222;color:#fff;border:1px solid #666;border-radius:4px;font-size:18px;cursor:pointer">×</button></div><div data-drop tabindex="0" style="margin-top:9px;padding:14px;border:2px dashed #2ee6d6;border-radius:6px;background:#081012;text-align:center;outline:none;cursor:text"><b>1.</b> Press <b>Win + Shift + S</b><br><b>2.</b> Drag your snip<br><b>3.</b> Come back here and press <b>Ctrl + V</b><div style="margin-top:6px;color:#8ca5a3;font-size:12px">The pasted image will appear below.</div></div><img data-i style="display:none;width:100%;max-height:320px;object-fit:contain;background:#000;border:1px solid #555;margin-top:9px"><textarea data-q placeholder="Ask something about this clipped image..." style="box-sizing:border-box;width:100%;min-height:82px;margin-top:8px;background:#090b0c;color:#fff;border:1px solid #567;padding:8px;border-radius:4px"></textarea><div style="display:flex;gap:7px;margin-top:8px;flex-wrap:wrap"><button data-a style="background:#18b7a7;color:#fff;border:0;border-radius:5px;padding:8px 12px;font-weight:700;cursor:pointer">Analyze</button><button data-clear style="background:#333;color:#fff;border:1px solid #666;border-radius:5px;padding:8px 12px;cursor:pointer">Clear Image</button></div><div data-o style="margin-top:9px;color:#ddd;white-space:pre-wrap"></div>';let drop=p.querySelector("[data-drop]"),img=p.querySelector("[data-i]"),out=p.querySelector("[data-o]");p.querySelector("[data-x]").onclick=()=>{rm(p);S.p=null};p.querySelector("[data-clear]").onclick=()=>{S.data=null;img.removeAttribute("src");img.style.display="none";drop.style.display="block";out.textContent="";drop.focus()};p.querySelector("[data-a]").onclick=()=>{let q=p.querySelector("[data-q]").value.trim();if(!S.data){out.textContent="Paste a snip first.";return}if(!q){out.textContent="Type a question first.";return}out.textContent="Snip received successfully. AI connection is the next step."};S.paste=e=>{let items=[...(e.clipboardData?.items||[])],it=items.find(x=>x.type&&x.type.startsWith("image/"));if(!it)return;let f=it.getAsFile(),r=new FileReader();r.onload=()=>{S.data=r.result;img.src=S.data;img.style.display="block";drop.style.display="none";out.textContent="Image pasted. Type a question and click Analyze.";p.querySelector("[data-q]").focus()};r.readAsDataURL(f);e.preventDefault()};p.addEventListener("paste",S.paste,true);document.body.appendChild(p);setTimeout(()=>drop.focus(),0)}S.k=e=>{if(e.key==="F5"){e.preventDefault();e.stopImmediatePropagation();openPanel()}};addEventListener("keydown",S.k,true);S.off=()=>{removeEventListener("keydown",S.k,true);rm(S.p);delete window.__acvPasteAI;note("ACV AI Snip OFF")};window.__acvPasteAI=S;note("ACV AI Snip ON • F5")})();
